{
  "name": "honeydrop",
  "version": "1.0.3",
  "description": "A lightweight, developer-friendly helper library for Socket.IO applications",
  "main": "dist/honeydrop.cjs.js",
  "module": "dist/honeydrop.esm.js",
  "browser": "dist/honeydrop.umd.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/honeydrop.esm.js",
      "require": "./dist/honeydrop.cjs.js",
      "browser": "./dist/honeydrop.umd.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "npx tsx node_modules/tesht.js/bin/tesht.js tests/",
    "test:watch": "npx tsx node_modules/tesht.js/bin/tesht.js tests/ --watch",
    "prepublishOnly": "npm run build",
    "demo": "cd demo && npm start"
  },
  "keywords": [
    "socket.io",
    "socket-io",
    "websocket",
    "real-time",
    "realtime",
    "events",
    "helper",
    "utility",
    "connection",
    "reconnection",
    "rooms",
    "rpc",
    "offline-queue",
    "event-emitter",
    "react-hooks",
    "use-socket"
  ],
  "author": "Neeraj",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neeer4j/honeydrop.js.git"
  },
  "bugs": {
    "url": "https://github.com/neeer4j/honeydrop.js/issues"
  },
  "homepage": "https://github.com/neeer4j/honeydrop.js#readme",
  "peerDependencies": {
    "socket.io-client": "^4.0.0 || ^5.0.0",
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "rollup": "^4.9.6",
    "rollup-plugin-dts": "^6.1.0",
    "tesht.js": "^1.1.0",
    "tslib": "^2.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}